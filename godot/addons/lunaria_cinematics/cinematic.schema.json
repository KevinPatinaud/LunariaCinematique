{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lunaria Cinematic v1 / v2 / v3",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "id": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "presentationCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "file"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "file": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        }
      }
    },
    "stage": {
      "type": "object",
      "properties": {
        "width": {
          "const": 1600
        },
        "height": {
          "const": 900
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "name": {
            "type": "string",
            "maxLength": 180
          },
          "duration": {
            "type": "number",
            "minimum": 1,
            "maximum": 300
          },
          "background": {
            "type": "object",
            "properties": {
              "asset": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 11,
                "maxLength": 1024,
                "pattern": "^library://[^\\\\\\u0000-\\u001f:?#]+$"
              },
              "fit": {
                "type": "string",
                "enum": [
                  "cover",
                  "contain"
                ]
              }
            },
            "required": [
              "asset",
              "fit"
            ],
            "additionalProperties": false
          },
          "camera": {
            "type": "object",
            "properties": {
              "preset": {
                "type": "string",
                "enum": [
                  "fixed",
                  "zoom_in",
                  "zoom_out",
                  "pan_left",
                  "pan_right",
                  "pan_up",
                  "pan_down"
                ]
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "preset",
              "intensity"
            ],
            "additionalProperties": false
          },
          "transition": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "cut",
                  "fade"
                ]
              },
              "duration": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              }
            },
            "required": [
              "type",
              "duration"
            ],
            "additionalProperties": false
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 2
                },
                "y": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 2
                },
                "width": {
                  "type": "number",
                  "minimum": 0.03,
                  "maximum": 2
                },
                "height": {
                  "type": "number",
                  "minimum": 0.03,
                  "maximum": 2
                },
                "animation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "animationId",
                    "speciesId",
                    "slot",
                    "speed"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "animation",
                        "species"
                      ]
                    },
                    "animationId": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 100,
                      "pattern": "^[a-zA-Z0-9_-]*$"
                    },
                    "speciesId": {
                      "type": "string",
                      "minLength": 0,
                      "maxLength": 100,
                      "pattern": "^[a-zA-Z0-9_-]*$"
                    },
                    "slot": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[a-zA-Z0-9_-]+$"
                    },
                    "speed": {
                      "type": "number",
                      "minimum": 0.05,
                      "maximum": 10
                    }
                  }
                },
                "id": {
                  "type": "string",
                  "maxLength": 100,
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "maxLength": 180
                },
                "asset": {
                  "type": "string",
                  "minLength": 11,
                  "maxLength": 1024,
                  "pattern": "^library://[^\\\\\\u0000-\\u001f:?#]+$"
                },
                "flipX": {
                  "type": "boolean"
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "entry": {
                  "type": "object",
                  "properties": {
                    "preset": {
                      "type": "string",
                      "enum": [
                        "none",
                        "fade",
                        "left",
                        "right",
                        "bottom",
                        "top",
                        "pop",
                        "zoom"
                      ]
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 10
                    },
                    "delay": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 300
                    }
                  },
                  "required": [
                    "preset",
                    "duration",
                    "delay"
                  ],
                  "additionalProperties": false
                },
                "exit": {
                  "type": "object",
                  "properties": {
                    "preset": {
                      "type": "string",
                      "enum": [
                        "none",
                        "fade",
                        "left",
                        "right",
                        "top",
                        "bottom",
                        "shrink"
                      ]
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 300
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 10
                    }
                  },
                  "required": [
                    "preset",
                    "start",
                    "duration"
                  ],
                  "additionalProperties": false
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "character",
                    "enemy",
                    "prop"
                  ]
                },
                "rotation": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "pivot": {
                  "type": "string",
                  "enum": [
                    "center",
                    "top",
                    "bottom"
                  ]
                },
                "motion": {
                  "type": "object",
                  "properties": {
                    "preset": {
                      "type": "string",
                      "enum": [
                        "none",
                        "float",
                        "sway",
                        "pulse",
                        "spin",
                        "shake",
                        "bounce",
                        "nod",
                        "recoil",
                        "heartbeat",
                        "flutter"
                      ]
                    },
                    "intensity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "period": {
                      "type": "number",
                      "minimum": 0.2,
                      "maximum": 60
                    },
                    "delay": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 300
                    },
                    "loop": {
                      "type": "boolean"
                    },
                    "reverse": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "preset",
                    "intensity",
                    "period",
                    "delay",
                    "loop",
                    "reverse"
                  ],
                  "additionalProperties": false
                },
                "movement": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "dx": {
                      "type": "number",
                      "minimum": -3,
                      "maximum": 3
                    },
                    "dy": {
                      "type": "number",
                      "minimum": -3,
                      "maximum": 3
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 300
                    },
                    "delay": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 300
                    },
                    "easing": {
                      "type": "string",
                      "enum": [
                        "smooth",
                        "linear"
                      ]
                    },
                    "repeat": {
                      "type": "string",
                      "enum": [
                        "once",
                        "pingpong"
                      ]
                    }
                  },
                  "required": [
                    "enabled",
                    "dx",
                    "dy",
                    "duration",
                    "delay",
                    "easing",
                    "repeat"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height",
                "id",
                "name",
                "asset",
                "flipX",
                "opacity",
                "entry"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 50
          },
          "bubbles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 2
                },
                "y": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 2
                },
                "width": {
                  "type": "number",
                  "minimum": 0.03,
                  "maximum": 2
                },
                "height": {
                  "type": "number",
                  "minimum": 0.03,
                  "maximum": 2
                },
                "id": {
                  "type": "string",
                  "maxLength": 100,
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "speech",
                    "narration"
                  ]
                },
                "style": {
                  "type": "string",
                  "enum": [
                    "parchment",
                    "plain",
                    "simple",
                    "ornate"
                  ]
                },
                "frameAsset": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 11,
                  "maxLength": 1024,
                  "pattern": "^library://[^\\\\\\u0000-\\u001f:?#]+$"
                },
                "speakerId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 100,
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "maxLength": 1500
                },
                "fontSize": {
                  "type": "number",
                  "minimum": 18,
                  "maximum": 72
                },
                "autoHeight": {
                  "type": "boolean"
                },
                "tail": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "auto",
                        "manual",
                        "none"
                      ]
                    },
                    "x": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 2
                    },
                    "y": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 2
                    }
                  },
                  "required": [
                    "mode",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "textAnimation": {
                  "type": "object",
                  "properties": {
                    "reveal": {
                      "type": "string",
                      "enum": [
                        "instant",
                        "typewriter",
                        "words",
                        "fade"
                      ]
                    },
                    "effect": {
                      "type": "string",
                      "enum": [
                        "none",
                        "shout",
                        "wave",
                        "shake",
                        "bounce"
                      ]
                    },
                    "speed": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 120
                    },
                    "delay": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 30
                    },
                    "duration": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 10
                    },
                    "intensity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "loop": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "reveal",
                    "effect",
                    "speed",
                    "delay",
                    "duration",
                    "intensity",
                    "loop"
                  ],
                  "additionalProperties": false
                },
                "advance": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "click",
                        "auto"
                      ]
                    },
                    "seconds": {
                      "type": "number",
                      "minimum": 0.5,
                      "maximum": 120
                    }
                  },
                  "required": [
                    "mode",
                    "seconds"
                  ],
                  "additionalProperties": false
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 1500
                  },
                  "minItems": 0,
                  "maxItems": 1501
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height",
                "id",
                "kind",
                "style",
                "frameAsset",
                "speakerId",
                "text",
                "fontSize",
                "autoHeight",
                "tail",
                "advance"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 100
          },
          "dialogueStart": {
            "type": "number",
            "minimum": 0,
            "maximum": 300
          },
          "audio": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "asset": {
                "type": "string",
                "minLength": 11,
                "maxLength": 1024,
                "pattern": "^library://[^\\\\\\u0000-\\u001f:?#]+$"
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "loop": {
                "type": "boolean"
              }
            },
            "required": [
              "asset",
              "volume",
              "loop"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "duration",
          "background",
          "camera",
          "transition",
          "actors",
          "bubbles",
          "dialogueStart",
          "audio"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 500
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "stage",
    "shots"
  ],
  "additionalProperties": false
}
